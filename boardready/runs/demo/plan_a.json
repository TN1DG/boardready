 "A3_cat_2026-06": [
  "query_transactions",
  {
   "organisation_id": "org_01m5d5cmjbe49a5y4d904dq3c8",
   "where": {
    "status": "BOOKED",
    "direction": "debit",
    "date": {
     "gte": "2026-06-01",
     "lt": "2026-07-01"
    }
   },
   "include_excluded_from_runway": false,
   "aggregate": {
    "group_by": [
     {
      "field": "date",
      "interval": "month"
     },
     {
      "field": "category_id"
     }
    ],
    "metrics": [
     {
      "function": "sum",
      "field": "reporting_amount",
      "as": "cat_spend"
     },
     {
      "function": "count",
      "as": "cat_n"
     }
    ]
   },
   "limit": 100
  }
