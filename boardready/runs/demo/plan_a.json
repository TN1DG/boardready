 "A5_burn_out": [
  "query_transactions",
  {
   "organisation_id": "org_01m5d5cmjbe49a5y4d904dq3c8",
   "where": {
    "date": {
     "gte": "2026-06-01",
     "lt": "2026-10-01"
    },
    "not": {
     "status": [
      "FAILED",
      "CANCELLED",
      "FULL_REVERSAL"
     ]
    },
    "or": [
     {
      "direction": "debit"
     },
     {
      "direction": "credit",
      "type": [
       "REFUND",
       "CARD_REFUND",
       "CARD_CHARGEBACK"
      ]
     }
    ]
   },
   "include_excluded_from_runway": false,
   "aggregate": {
    "group_by": [
     {
      "field": "date",
      "interval": "month"
     },
     {
      "field": "direction"
     }
    ],
    "metrics": [
     {
      "function": "sum",
      "field": "reporting_amount",
      "as": "burn_out"
     }
    ]
   },
   "limit": 100
  }
 ],
 "A5_burn_in": [
  "query_transactions",
  {
   "organisation_id": "org_01m5d5cmjbe49a5y4d904dq3c8",
   "where": {
    "date": {
     "gte": "2026-06-01",
     "lt": "2026-10-01"
    },
    "direction": "credit",
    "not": {
     "status": [
      "FAILED",
      "CANCELLED",
      "FULL_REVERSAL"
     ]
    },
    "and": [
     {
      "not": {
       "type": [
        "REFUND",
        "CARD_REFUND",
        "CARD_CHARGEBACK"
       ]
      }
     }
    ]
   },
   "include_excluded_from_runway": false,
   "aggregate": {
    "group_by": [
     {
      "field": "date",
      "interval": "month"
     },
     {
      "field": "category_id"
     }
    ],
    "metrics": [
     {
      "function": "sum",
      "field": "reporting_amount",
      "as": "burn_in"
     }
    ]
   },
   "limit": 100
  }
 ],
